%%{init: {"themeVariables": {"fontSize": "20px"}, "sequence": {"actorFontSize": 18, "messageFontSize": 18, "noteFontSize": 16}}}%%
sequenceDiagram
  autonumber
  actor Driver as Tài xế
  participant App as Driver App
  participant Gateway as API Gateway
  participant Auth as Auth Service
  participant DB as auth_db

  Driver->>App: Nhập SĐT và mật khẩu
  App->>App: Kiểm tra định dạng SĐT
  alt Dữ liệu hợp lệ
    App->>Gateway: POST /api/auth/login
    Gateway->>Auth: Login(identifier, password)
    Auth->>DB: Tìm user bằng phone/email/identifier
    alt ACTIVE và mật khẩu đúng
      Auth->>DB: Lưu refresh token
      Auth-->>Gateway: User + JWT
      Gateway-->>App: Phiên đăng nhập
      App->>App: Kiểm tra user.role == DRIVER
      alt Đúng vai trò DRIVER
        App->>App: Lưu token và thông tin tài xế
        App-->>Driver: Chuyển tới /dashboard
      else Sai vai trò
        App-->>Driver: Chặn đăng nhập tài xế
      end
    else Sai tài khoản, khóa hoặc chưa xác thực
      Auth-->>Gateway: LOGIN_FAILED
      Gateway-->>App: Trả lỗi đăng nhập
      App-->>Driver: Hiển thị thông báo lỗi
    end
  else Dữ liệu không hợp lệ
    App-->>Driver: Yêu cầu sửa SĐT hoặc mật khẩu
  end
